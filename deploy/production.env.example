# Set these in the hosting platform's encrypted environment store. Never commit
# a populated copy of this file and never put values in build arguments.
APP_ENV=production
PORT=3001
# Production startup rejects encryption without peer verification. Use
# sslrootcert=system with the platform trust store, or an existing absolute
# CA-bundle path mounted read-only into every API and worker container.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/electronic_mail?sslmode=verify-full&sslrootcert=system&gssencmode=disable

CORS_ORIGIN=https://app.example.com
WEB_APP_URL=https://app.example.com
APP_SESSION_SECRET=generate-at-least-32-random-characters
APP_ENCRYPTION_KEY=generate-separate-at-least-32-random-characters
SESSION_COOKIE_DOMAIN=.example.com
# The production web and API hosts share this cookie domain. Lax supports the
# top-level Google OAuth redirect while rejecting cross-site subrequests.
SESSION_COOKIE_SAMESITE=lax

# Choose deliberately. Use allowlist for a private beta; use open only after
# OAuth verification, global edge rate limits, abuse monitoring, and support
# operations are live.
REGISTRATION_MODE=allowlist
ALLOWED_EMAILS=owner@example.com

GOOGLE_CLIENT_ID=replace-in-secret-store
GOOGLE_CLIENT_SECRET=replace-in-secret-store
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback
MOBILE_REDIRECT_URI=electronicmail://auth/callback

# Full is a launch invariant. The recent-day window is only the fast first
# batch; the durable backfill continues through the entire mailbox.
GMAIL_SYNC_SCOPE=full
GMAIL_RECENT_DAYS=90
GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/gmail-push
GMAIL_PUBSUB_SUBSCRIPTION=gmail-push-production
GMAIL_PUBSUB_PUSH_AUDIENCE=https://api.example.com/v1/mailbox/pubsub
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=gmail-push@PROJECT_ID.iam.gserviceaccount.com
GMAIL_WATCH_RENEWAL_HOURS=24
GMAIL_POLL_INTERVAL_SECONDS=30
# Keep this false through the additive migration and verification deployment.
# It is enabled only after every existing user's preservation audit passes.
MULTI_GMAIL_ENABLED=false
MULTI_GMAIL_WRITES_ENABLED=false
MULTI_GMAIL_AI_ENABLED=false
MULTI_GMAIL_MAX_ACCOUNTS=5
# Set to the immutable provider backup/snapshot id only after a restore drill.
MULTI_GMAIL_VERIFIED_BACKUP_ID=

OPS_ADMIN_EMAILS=owner@example.com
LOG_LEVEL=INFO
# On GitHub-triggered Railway deploys, omit RELEASE_SHA: the runtime derives it
# from Railway's immutable RAILWAY_GIT_COMMIT_SHA and rejects a conflicting
# manually configured value. Set RELEASE_SHA only on another hosting platform.
RELEASE_SHA=
RATE_LIMIT_ENABLED=true
GMAIL_DEBUG_LOGS=false

# The retired grouping path and all provider diagnostics remain off. Set
# AI_INBOX_ENABLED=true only after the pgvector migration, AI worker, shadow
# generation, and promotion gates are ready. The OpenAI key must be populated
# only while AI Inbox is enabled; disabling the feature requires an empty key.
AI_GROUPING_ENABLED=false
OPENAI_REQUIRED=false
OPENAI_DEBUG_LOGS=false
AI_INBOX_ENABLED=false
AI_INBOX_LOCAL_SHADOW_PREVIEW=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_INBOX_TEXT_PROVIDER=openai
AI_INBOX_EMBEDDING_PROVIDER=openai
AI_INBOX_CLASSIFIER_MODEL=gpt-5.6-luna
AI_INBOX_REVIEW_MODEL=gpt-5.6-terra
AI_INBOX_EMBEDDING_MODEL=text-embedding-3-large
AI_INBOX_EMBEDDING_DIMENSIONS=1024
AI_INBOX_CODEX_SERVICE_TIER=default
AI_INBOX_CODEX_TIMEOUT_SECONDS=90
AI_INBOX_PROMPT_VERSION=matter-v6-event-chain-counterpart-identity
AI_INBOX_JOB_COST_LIMIT_USD=0.10
AI_INBOX_USER_MONTHLY_COST_LIMIT_USD=25
AI_INBOX_PROJECT_MONTHLY_COST_LIMIT_USD=250
# Update these configurable accounting rates from the approved provider price
# sheet before enabling AI Inbox. They never affect provider billing itself.
AI_INBOX_CLASSIFIER_INPUT_USD_PER_MILLION=0.20
AI_INBOX_CLASSIFIER_OUTPUT_USD_PER_MILLION=1.20
AI_INBOX_REVIEW_INPUT_USD_PER_MILLION=2.00
AI_INBOX_REVIEW_OUTPUT_USD_PER_MILLION=12.00
AI_INBOX_EMBEDDING_USD_PER_MILLION=0.13

# Public web/OAuth pages. These are not secrets, but must be real owned-domain
# values and must be approved by the product owner/legal reviewer.
DECISION_PIPELINE_BACKEND_URL=https://api.example.com
MACOS_DOWNLOAD_ENABLED=false
MACOS_DOWNLOAD_URL=https://downloads.your-owned-domain.example/ElectronicMail.dmg
LEGAL_ENTITY_NAME=replace-with-registered-operator
LEGAL_SUPPORT_EMAIL=support@your-owned-domain.example
STATUS_PAGE_URL=https://status.your-owned-domain.example
LEGAL_EFFECTIVE_DATE=2026-07-13
LEGAL_JURISDICTION=replace-after-legal-review
LEGAL_HOSTING_PROVIDERS=replace-with-the-reviewed-provider-and-subprocessor-summary
LEGAL_DATA_REGIONS=replace-with-the-reviewed-production-data-regions
LEGAL_BACKUP_RETENTION_DAYS=14
LEGAL_REVIEW_STATUS=needs-review
