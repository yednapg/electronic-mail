# Set these in the hosting platform's encrypted environment store. Never commit
# a populated copy of this file and never put values in build arguments.
APP_ENV=production
PORT=3001
# Production startup rejects encryption without peer verification. Use
# sslrootcert=system with the platform trust store, or an existing absolute
# CA-bundle path mounted read-only into every API and worker container.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/electronic_mail?sslmode=verify-full&sslrootcert=system&gssencmode=disable

CORS_ORIGIN=https://app.example.invalid
WEB_APP_URL=https://app.example.invalid
APP_SESSION_SECRET=generate-at-least-32-random-characters
APP_ENCRYPTION_KEY=generate-separate-at-least-32-random-characters
SESSION_COOKIE_DOMAIN=.example.invalid
# The production web and API hosts share this cookie domain. Lax supports the
# top-level Google OAuth redirect while rejecting cross-site subrequests.
SESSION_COOKIE_SAMESITE=lax

# Choose deliberately. Use allowlist for a open-source release; use open only after
# OAuth verification, global edge rate limits, abuse monitoring, and support
# operations are live.
REGISTRATION_MODE=allowlist
ALLOWED_EMAILS=operator@example.invalid

GOOGLE_CLIENT_ID=replace-in-secret-store
GOOGLE_CLIENT_SECRET=replace-in-secret-store
GOOGLE_REDIRECT_URI=https://api.example.invalid/auth/google/callback
MOBILE_REDIRECT_URI=electronicmail://auth/callback

# Full is a launch invariant. The recent-day window is only the fast first
# batch; the durable backfill continues through the entire mailbox.
GMAIL_SYNC_SCOPE=full
GMAIL_RECENT_DAYS=90
GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/gmail-push
GMAIL_PUBSUB_SUBSCRIPTION=gmail-push-production
GMAIL_PUBSUB_PUSH_AUDIENCE=https://api.example.invalid/v1/mailbox/pubsub
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=gmail-push@PROJECT_ID.iam.gserviceaccount.com
GMAIL_WATCH_RENEWAL_HOURS=24
GMAIL_POLL_INTERVAL_SECONDS=30

OPS_ADMIN_EMAILS=operator@example.invalid
LOG_LEVEL=INFO
# On GitHub-triggered Railway deploys, omit RELEASE_SHA: the runtime derives it
# from Railway's immutable RAILWAY_GIT_COMMIT_SHA and rejects a conflicting
# manually configured value. Set RELEASE_SHA only on another hosting platform.
RELEASE_SHA=
RATE_LIMIT_ENABLED=true
GMAIL_DEBUG_LOGS=false

# The launch is explicitly no-AI. Keep every AI feature/diagnostic switch off
# and leave the provider key empty.
AI_GROUPING_ENABLED=false
OPENAI_REQUIRED=false
OPENAI_DEBUG_LOGS=false
OPENAI_API_KEY=

# Public web/OAuth pages. These are not secrets, but must be real owned-domain
# values and must be approved by the product owner/legal reviewer.
ELECTRONIC_MAIL_BACKEND_URL=https://api.example.invalid
MACOS_DOWNLOAD_ENABLED=false
MACOS_DOWNLOAD_URL=https://downloads.example.invalid/ElectronicMail.dmg
LEGAL_ENTITY_NAME=Electronic Mail Operator
LEGAL_SUPPORT_EMAIL=support@example.invalid
STATUS_PAGE_URL=https://status.example.invalid
LEGAL_EFFECTIVE_DATE=2026-07-13
LEGAL_JURISDICTION=Example jurisdiction
LEGAL_HOSTING_PROVIDERS=Example hosting provider
LEGAL_DATA_REGIONS=Example region
LEGAL_BACKUP_RETENTION_DAYS=14
LEGAL_REVIEW_STATUS=example-only
