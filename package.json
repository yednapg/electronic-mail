{
  "name": "decision-pipeline-system",
  "private": true,
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "setup": "bash scripts/bootstrap.sh",
    "start": "npm run setup && npm run dev",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @decision-pipeline/web",
    "test": "npm run test -w @decision-pipeline/web",
    "typecheck": "npm run typecheck -w @decision-pipeline/types && npm run typecheck -w @decision-pipeline/web"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
